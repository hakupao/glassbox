# Optional, for local runs only (copy to .env, git-ignored). The Gitea workflow does not use a .env:
# everything below has a default in compose.yaml, and the workflow sets image, tag and DOCKER_GID.
# No secret belongs here; secrets are files under /opt/glassbox/secrets on the VM.
TS_HOSTNAME=glassbox
# Tag only. Do not add --advertise-routes or --advertise-exit-node.
TS_EXTRA_ARGS=--advertise-tags=tag:glassbox
GLASSBOX_COLLECT_INTERVAL=300
# Group id of the Docker socket:  stat -c %g /var/run/docker.sock
DOCKER_GID=<DOCKER_GROUP_ID>
