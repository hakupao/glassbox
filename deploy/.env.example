# Copy to .env (git-ignored). Non-secret settings only; secrets are files in ./secrets/.
TS_HOSTNAME=glassbox
# Recommended: tag the node so the tailnet ACL can restrict it (README section 4). The auth key
# must be allowed to create this tag.
TS_EXTRA_ARGS=--advertise-tags=tag:glassbox
GLASSBOX_COLLECT_INTERVAL=300
# Group id of the Docker socket on the deploy VM:  stat -c %g /var/run/docker.sock
DOCKER_GID=<DOCKER_GROUP_ID>
